{"nome":"XRHandTracker","herda":"XRPositionalTracker","breve":"A tracked hand in XR.","descricao":"A hand tracking system will create an instance of this object and add it to the XRServer. This tracking system will then obtain skeleton data, convert it to the Godot Humanoid hand skeleton and store this data on the XRHandTracker object.\nUse XRHandModifier3D to animate a hand mesh using hand tracking data.","metodos":[{"assinatura":"get_hand_joint_angular_velocity(joint: XRHandTracker.HandJoint) -> Vector3 const","desc":"Returns the angular velocity for the given hand joint."},{"assinatura":"get_hand_joint_flags(joint: XRHandTracker.HandJoint) -> XRHandTracker.HandJointFlags const","desc":"Returns flags about the validity of the tracking data for the given hand joint."},{"assinatura":"get_hand_joint_linear_velocity(joint: XRHandTracker.HandJoint) -> Vector3 const","desc":"Returns the linear velocity for the given hand joint."},{"assinatura":"get_hand_joint_radius(joint: XRHandTracker.HandJoint) -> float const","desc":"Returns the radius of the given hand joint."},{"assinatura":"get_hand_joint_transform(joint: XRHandTracker.HandJoint) -> Transform3D const","desc":"Returns the transform for the given hand joint."},{"assinatura":"set_hand_joint_angular_velocity(joint: XRHandTracker.HandJoint, angular_velocity: Vector3) -> void","desc":"Sets the angular velocity for the given hand joint."},{"assinatura":"set_hand_joint_flags(joint: XRHandTracker.HandJoint, flags: XRHandTracker.HandJointFlags) -> void","desc":"Sets flags about the validity of the tracking data for the given hand joint."},{"assinatura":"set_hand_joint_linear_velocity(joint: XRHandTracker.HandJoint, linear_velocity: Vector3) -> void","desc":"Sets the linear velocity for the given hand joint."},{"assinatura":"set_hand_joint_radius(joint: XRHandTracker.HandJoint, radius: float) -> void","desc":"Sets the radius of the given hand joint."},{"assinatura":"set_hand_joint_transform(joint: XRHandTracker.HandJoint, transform: Transform3D) -> void","desc":"Sets the transform for the given hand joint."}],"propriedades":[{"nome":"hand","tipo":"XRPositionalTracker.TrackerHand","padrao":"1"},{"nome":"hand_tracking_source","tipo":"XRHandTracker.HandTrackingSource","padrao":"0","desc":"The source of the hand tracking data."},{"nome":"has_tracking_data","tipo":"bool","padrao":"false","desc":"If true, the hand tracking data is valid."},{"nome":"type","tipo":"XRServer.TrackerType","padrao":"16"}],"constantes":[{"nome":"HAND_TRACKING_SOURCE_UNKNOWN","valor":"0","enum":"HandTrackingSource","desc":"The source of hand tracking data is unknown."},{"nome":"HAND_TRACKING_SOURCE_UNOBSTRUCTED","valor":"1","enum":"HandTrackingSource","desc":"The source of hand tracking data is unobstructed, meaning that an accurate method of hand tracking is used. These include optical hand tracking, data gloves, etc."},{"nome":"HAND_TRACKING_SOURCE_CONTROLLER","valor":"2","enum":"HandTrackingSource","desc":"The source of hand tracking data is a controller, meaning that joint positions are inferred from controller inputs."},{"nome":"HAND_TRACKING_SOURCE_NOT_TRACKED","valor":"3","enum":"HandTrackingSource","desc":"No hand tracking data is tracked, this either means the hand is obscured, the controller is turned off, or tracking is not supported for the current input type."},{"nome":"HAND_TRACKING_SOURCE_MAX","valor":"4","enum":"HandTrackingSource","desc":"Represents the size of the 'HandTrackingSource' enum."},{"nome":"HAND_JOINT_PALM","valor":"0","enum":"HandJoint","desc":"Palm joint."},{"nome":"HAND_JOINT_WRIST","valor":"1","enum":"HandJoint","desc":"Wrist joint."},{"nome":"HAND_JOINT_THUMB_METACARPAL","valor":"2","enum":"HandJoint","desc":"Thumb metacarpal joint."},{"nome":"HAND_JOINT_THUMB_PHALANX_PROXIMAL","valor":"3","enum":"HandJoint","desc":"Thumb phalanx proximal joint."},{"nome":"HAND_JOINT_THUMB_PHALANX_DISTAL","valor":"4","enum":"HandJoint","desc":"Thumb phalanx distal joint."},{"nome":"HAND_JOINT_THUMB_TIP","valor":"5","enum":"HandJoint","desc":"Thumb tip joint."},{"nome":"HAND_JOINT_INDEX_FINGER_METACARPAL","valor":"6","enum":"HandJoint","desc":"Index finger metacarpal joint."},{"nome":"HAND_JOINT_INDEX_FINGER_PHALANX_PROXIMAL","valor":"7","enum":"HandJoint","desc":"Index finger phalanx proximal joint."},{"nome":"HAND_JOINT_INDEX_FINGER_PHALANX_INTERMEDIATE","valor":"8","enum":"HandJoint","desc":"Index finger phalanx intermediate joint."},{"nome":"HAND_JOINT_INDEX_FINGER_PHALANX_DISTAL","valor":"9","enum":"HandJoint","desc":"Index finger phalanx distal joint."},{"nome":"HAND_JOINT_INDEX_FINGER_TIP","valor":"10","enum":"HandJoint","desc":"Index finger tip joint."},{"nome":"HAND_JOINT_MIDDLE_FINGER_METACARPAL","valor":"11","enum":"HandJoint","desc":"Middle finger metacarpal joint."},{"nome":"HAND_JOINT_MIDDLE_FINGER_PHALANX_PROXIMAL","valor":"12","enum":"HandJoint","desc":"Middle finger phalanx proximal joint."},{"nome":"HAND_JOINT_MIDDLE_FINGER_PHALANX_INTERMEDIATE","valor":"13","enum":"HandJoint","desc":"Middle finger phalanx intermediate joint."},{"nome":"HAND_JOINT_MIDDLE_FINGER_PHALANX_DISTAL","valor":"14","enum":"HandJoint","desc":"Middle finger phalanx distal joint."},{"nome":"HAND_JOINT_MIDDLE_FINGER_TIP","valor":"15","enum":"HandJoint","desc":"Middle finger tip joint."},{"nome":"HAND_JOINT_RING_FINGER_METACARPAL","valor":"16","enum":"HandJoint","desc":"Ring finger metacarpal joint."},{"nome":"HAND_JOINT_RING_FINGER_PHALANX_PROXIMAL","valor":"17","enum":"HandJoint","desc":"Ring finger phalanx proximal joint."},{"nome":"HAND_JOINT_RING_FINGER_PHALANX_INTERMEDIATE","valor":"18","enum":"HandJoint","desc":"Ring finger phalanx intermediate joint."},{"nome":"HAND_JOINT_RING_FINGER_PHALANX_DISTAL","valor":"19","enum":"HandJoint","desc":"Ring finger phalanx distal joint."},{"nome":"HAND_JOINT_RING_FINGER_TIP","valor":"20","enum":"HandJoint","desc":"Ring finger tip joint."},{"nome":"HAND_JOINT_PINKY_FINGER_METACARPAL","valor":"21","enum":"HandJoint","desc":"Pinky finger metacarpal joint."},{"nome":"HAND_JOINT_PINKY_FINGER_PHALANX_PROXIMAL","valor":"22","enum":"HandJoint","desc":"Pinky finger phalanx proximal joint."},{"nome":"HAND_JOINT_PINKY_FINGER_PHALANX_INTERMEDIATE","valor":"23","enum":"HandJoint","desc":"Pinky finger phalanx intermediate joint."},{"nome":"HAND_JOINT_PINKY_FINGER_PHALANX_DISTAL","valor":"24","enum":"HandJoint","desc":"Pinky finger phalanx distal joint."},{"nome":"HAND_JOINT_PINKY_FINGER_TIP","valor":"25","enum":"HandJoint","desc":"Pinky finger tip joint."},{"nome":"HAND_JOINT_MAX","valor":"26","enum":"HandJoint","desc":"Represents the size of the 'HandJoint' enum."},{"nome":"HAND_JOINT_FLAG_ORIENTATION_VALID","valor":"1","enum":"HandJointFlags","desc":"The hand joint's orientation data is valid."},{"nome":"HAND_JOINT_FLAG_ORIENTATION_TRACKED","valor":"2","enum":"HandJointFlags","desc":"The hand joint's orientation is actively tracked. May not be set if tracking has been temporarily lost."},{"nome":"HAND_JOINT_FLAG_POSITION_VALID","valor":"4","enum":"HandJointFlags","desc":"The hand joint's position data is valid."},{"nome":"HAND_JOINT_FLAG_POSITION_TRACKED","valor":"8","enum":"HandJointFlags","desc":"The hand joint's position is actively tracked. May not be set if tracking has been temporarily lost."},{"nome":"HAND_JOINT_FLAG_LINEAR_VELOCITY_VALID","valor":"16","enum":"HandJointFlags","desc":"The hand joint's linear velocity data is valid."},{"nome":"HAND_JOINT_FLAG_ANGULAR_VELOCITY_VALID","valor":"32","enum":"HandJointFlags","desc":"The hand joint's angular velocity data is valid."}]}